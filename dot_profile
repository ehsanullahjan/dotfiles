# Safely prepend path (idempotent & posix compliant)
safe_prepend_path() {
    if [ -d "$1" ]; then
        case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
        esac
    fi
}

# Add bin dirs to path
safe_prepend_path "$HOME/.local/bin"
safe_prepend_path "$HOME/Local/bin"
export PATH

